# Обязательно
BOT_TOKEN=your_bot_token_here

# Необязательно
PORT=3000
WEBAPP_URL=https://dsanik.github.io/daily-dilemma/

# Часовой пояс, по которому считаются "сутки" для стрика и время крона
# напоминаний (20:00 по этому поясу). Должен быть одинаковым везде,
# иначе стрик на сервере и на клиенте будет расходиться.
APP_TIMEZONE=Europe/Minsk

# Путь к файлу данных, если НЕ используете Upstash (см. ниже).
# По умолчанию — рядом с кодом (server/data.json), что НЕ переживает
# передеплой на большинстве PaaS с эфемерным диском.
# Если у сервиса подключён persistent disk / volume — укажите путь
# внутри него, например:
# DATA_FILE=/data/data.json

# Рекомендуемый бесплатный способ пережить редеплой БЕЗ persistent disk:
# заведите бесплатную базу на upstash.com (Redis, постоянный free tier,
# без 30-дневного лимита) и укажите её REST-креды здесь. Если заданы —
# данные хранятся там, а DATA_FILE выше игнорируется.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
